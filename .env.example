APP_ENV=local
LOG_LEVEL=INFO

# Chat credentials are supplied per request in X-LLM-API-Key.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_STANDARD_MODEL=deepseek-flash
DEEPSEEK_DEEP_MODEL=deepseek-v4-pro
DEEPSEEK_ALLOWED_MODELS_JSON=["deepseek-flash","deepseek-v4-pro"]
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Embeddings run locally through the OpenAI-compatible Ollama container.
LOCAL_EMBEDDING_IMAGE=docker.1ms.run/ollama/ollama:latest
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_EMBEDDING_DIMENSION=1024
LOCAL_EMBEDDING_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_PATH=/embeddings
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_PATH=/embeddings
RAG_EMBEDDING_DIMENSION=1024
OPENSEARCH_ENABLED=true
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=openfinance_news_chunks
OPENSEARCH_ANNUAL_REPORT_INDEX=openfinance_annual_report_chunks
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=replace-with-a-strong-password
RAG_CANDIDATE_LIMIT=50
RAG_RRF_K=60
RAG_MMR_LAMBDA=0.7
RAG_TIME_DECAY_HALF_LIFE_DAYS=14
RAG_SOURCE_WEIGHTS_JSON={}
RAG_RERANK_ENABLED=false
RAG_RERANK_URL=https://your-reranker.example/v2/rerank
RAG_RERANK_API_KEY=replace-me
RAG_RERANK_MODEL=rerank-v3.5
RAG_RERANK_MIN_SCORE=0.15
RAG_ANNUAL_REPORT_VECTOR_TABLE=annual_report_chunks


HARNESS_V1_ENABLED=true
HARNESS_DYNAMIC_BUDGET_ENABLED=true
HARNESS_STANDARD_MAX_TOOL_CALLS=6
HARNESS_STANDARD_MAX_STEPS=3
HARNESS_STANDARD_TIMEOUT_SECONDS=60
HARNESS_DEEP_MAX_TOOL_CALLS=12
HARNESS_DEEP_MAX_STEPS=5
HARNESS_DEEP_TIMEOUT_SECONDS=180
HARNESS_BUDGET_SIMPLE_MAX_TOOL_CALLS=3
HARNESS_BUDGET_SIMPLE_MAX_STEPS=2
HARNESS_BUDGET_SIMPLE_TIMEOUT_SECONDS=45
HARNESS_BUDGET_MEDIUM_MAX_TOOL_CALLS=8
HARNESS_BUDGET_MEDIUM_MAX_STEPS=4
HARNESS_BUDGET_MEDIUM_TIMEOUT_SECONDS=90
HARNESS_BUDGET_COMPLEX_MAX_TOOL_CALLS=16
HARNESS_BUDGET_COMPLEX_MAX_STEPS=6
HARNESS_BUDGET_COMPLEX_TIMEOUT_SECONDS=240
HARNESS_BUDGET_HARD_MAX_TOOL_CALLS=20
HARNESS_BUDGET_HARD_MAX_STEPS=8
HARNESS_BUDGET_HARD_TIMEOUT_SECONDS=360
HARNESS_BUDGET_REVIEW_MIN_CONFIDENCE=0.7
HARNESS_BUDGET_MAX_NO_PROGRESS_ROUNDS=2
HARNESS_MAX_PARALLEL_TOOLS=4
HARNESS_CONTEXT_MAX_CHARS=24000
HARNESS_CONTEXT_RECENT_MESSAGES=12
HARNESS_APPROVAL_TTL_SECONDS=86400
HARNESS_CHECKPOINT_RETENTION_DAYS=30
AGENT_WEB_FETCH_TIMEOUT_SECONDS=10
AGENT_WEB_MAX_BYTES=2000000
AGENT_WEB_MAX_REDIRECTS=3
AGENT_WEB_CACHE_TTL_SECONDS=3600
AGENT_WEB_SEARCH_ENABLED=true
AGENT_WEB_SEARCH_ENDPOINT=https://www.cninfo.com.cn/new/fulltextSearch/full
AGENT_WEB_ANNOUNCEMENT_ENDPOINT=https://www.cninfo.com.cn/new/hisAnnouncement/query
AGENT_WEB_SEARCH_MAX_RESULTS=8
AGENT_WEB_SEARCH_FETCH_LIMIT=3

DATABASE_URL=postgresql://openfinance:openfinance@localhost:5432/openfinance

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_DERIVED_BUCKET=openfinance-derived
MINIO_REGION=us-east-1
MINIO_BRONZE_BUCKET=openfinance-bronze
MINIO_WAREHOUSE_BUCKET=openfinance-warehouse

ICEBERG_CATALOG_NAME=openfinance
ICEBERG_CATALOG_URI=postgresql+psycopg://openfinance:openfinance@localhost:5432/openfinance
ICEBERG_WAREHOUSE=s3://openfinance-warehouse/

# Optional daily-history reader. Enable only after the StarRocks validation in docs/starrocks-daily.md.
MARKET_DAILY_READER=iceberg
STARROCKS_HOST=localhost
STARROCKS_PORT=19030
STARROCKS_USER=openfinance_reader
STARROCKS_PASSWORD=
STARROCKS_CATALOG=openfinance
STARROCKS_CONNECT_TIMEOUT_SECONDS=5
STARROCKS_QUERY_TIMEOUT_SECONDS=45
STARROCKS_ICEBERG_JDBC_PASSWORD=
STARROCKS_S3_SECRET_KEY=
# Spark standalone worker capacity; size these for the deployment host.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
ICEBERG_NAMESPACE=openfinance
ICEBERG_NEWS_TABLE=news_articles
ICEBERG_ANNUAL_REPORT_TABLE=annual_reports
ICEBERG_ANNUAL_REPORT_PAGE_TABLE=annual_report_pages
ICEBERG_ANNUAL_REPORT_SECTION_TABLE=annual_report_sections
ICEBERG_ANNUAL_REPORT_PARSE_RUN_TABLE=annual_report_parse_runs
ICEBERG_ANNUAL_REPORT_REGION_TABLE=annual_report_regions
ICEBERG_ANNUAL_REPORT_CHUNK_TABLE=annual_report_chunks
ICEBERG_GOLD_METRICS_TABLE=gold_security_daily_metrics
ICEBERG_S3_PATH_STYLE_ACCESS=true

NEWS_HTTP_TIMEOUT_SECONDS=10
NEWS_HTTP_MAX_RETRIES=0
NEWS_HTTP_RETRY_BACKOFF_SECONDS=1
NEWS_DEFAULT_LIMIT=50

CAIXIN_NEWS_URL=https://cxdata.caixin.com/api/dataplus/sjtPc/news

NEWS_EMPTY_RESULT_MESSAGE=当前自有湖仓在指定时间范围内未检索到相关新闻。
NEWS_SYMBOL_ALIASES={"NVDA":["NVIDIA","英伟达"],"AAPL":["Apple","苹果"],"TSLA":["Tesla","特斯拉"],"MSFT":["Microsoft","微软"]}
NEWS_INGEST_LOOKBACK_HOURS=6
NEWS_AIRFLOW_SCHEDULE=*/30 * * * *
CNINFO_REPORT_STOCKS_JSON=["600519.SH"]
CNINFO_REPORT_YEARS_JSON=[2024]
CNINFO_REPORT_AIRFLOW_SCHEDULE=0 3 * * *
PDF_PARSER_URL=http://pdf-parser:8090
PDF_PARSER_TOKEN=replace-with-pdf-parser-token
PDF_PARSER_TIMEOUT_SECONDS=14400
PDF_PARSER_VERSION=annual-report-mineru-basic-4.0.12-v1
PDF_LAYOUT_ENGINE=mineru
PDF_MINERU_TIER=basic
PDF_RENDER_DPI=200
PDF_OCR_CONFIDENCE_THRESHOLD=0.78
RAY_ADDRESS=auto
# Set to the Ray head node's Dashboard address reachable from the backend container.
RAY_DASHBOARD_URL=http://<ray-server-host>:8265
RAY_RUNTIME_WORKING_DIR=/app
# These addresses are consumed by Ray workers outside the Compose network.
# Replace <reachable-host> with a host/IP resolvable from every Ray node;
# localhost and Compose service names are invalid unless workers share that network.
RAY_DATABASE_URL=postgresql://openfinance:openfinance@<reachable-host>:5432/openfinance
RAY_MINIO_ENDPOINT=<reachable-host>:9000
RAY_MINIO_ACCESS_KEY=minioadmin
RAY_MINIO_SECRET_KEY=minioadmin
RAY_MINIO_SECURE=false
RAY_MINIO_REGION=us-east-1
RAY_ICEBERG_CATALOG_URI=postgresql+psycopg://openfinance:openfinance@<reachable-host>:5432/openfinance
RAY_ICEBERG_WAREHOUSE=s3://openfinance-warehouse/
# Keep empty when worker images already contain project/Paddle dependencies.
RAY_RUNTIME_PIP_PACKAGES_JSON=[]
# Optional package indexes used only while Ray builds a runtime env. For
# Paddle GPU, keep PyPI as the primary index and use the Paddle CUDA index as
# the extra index.
RAY_RUNTIME_PIP_INDEX_URL=
RAY_RUNTIME_PIP_EXTRA_INDEX_URL=https://www.paddlepaddle.org.cn/packages/stable/cu129/
RAY_CPU_TASK_CPUS=4
RAY_GPU_TASK_CPUS=4
RAY_MAX_IN_FLIGHT_REPORTS=24
RAY_CPU_RESOURCE_LABEL=annual_report_cpu
RAY_GPU_RESOURCE_LABEL=annual_report_gpu
RAY_JOB_TIMEOUT_SECONDS=14400
RAY_JOB_POLL_SECONDS=5
# Per-report attempts in full backfill; retry only after a terminal Ray failure.
ANNUAL_REPORT_REPLAY_MAX_ATTEMPTS=3
ANNUAL_REPORT_REPLAY_RETRY_DELAY_SECONDS=30
ANNUAL_REPORT_RECOVERY_SCHEDULE=15 4 * * *
ANNUAL_REPORT_MAX_STAGE_ATTEMPTS=5
OPENFINANCE_INTERNAL_API_BASE_URL=http://backend:8000
OPENFINANCE_INTERNAL_API_TOKEN=replace-with-a-shared-internal-token
A_SHARE_DAILY_AIRFLOW_SCHEDULE=15 18 * * 1-5
A_SHARE_DAILY_LOOKBACK_DAYS=3
A_SHARE_DAILY_ADJUSTMENT_TYPE=none
A_SHARE_BACKFILL_START_DATE=1990-01-01
A_SHARE_BATCH_SIZE=100
A_SHARE_FAILED_SYMBOL_RETRIES=2
A_SHARE_MAX_ACTIVE_BATCHES=8
# Server daily bars and security metadata use Tencent; calendars use BaoStock.
FINANCE_DAILY_PROVIDER=tencent
A_SHARE_INGEST_WORKERS=8
TENCENT_CONNECT_TIMEOUT_SECONDS=5
TENCENT_READ_TIMEOUT_SECONDS=15
TENCENT_MAX_RETRIES=2
TENCENT_RETRY_BACKOFF_SECONDS=2
# Optional local quota; 0 disables it. This is not an upstream guarantee.
TENCENT_DAILY_REQUEST_LIMIT=0
BAOSTOCK_SOCKET_TIMEOUT_SECONDS=15
BAOSTOCK_SYMBOL_TIMEOUT_SECONDS=45
BAOSTOCK_MAX_RETRIES=2
BAOSTOCK_RETRY_BACKOFF_SECONDS=2
BAOSTOCK_DAILY_REQUEST_LIMIT=50000
A_SHARE_GAP_LOOKBACK_DAYS=60
A_SHARE_MAX_SYMBOLS_PER_RUN=10000
A_SHARE_INGEST_BATCH_SIZE=20
A_SHARE_NORMALIZATION_BATCH_SIZE=300
A_SHARE_BACKFILL_NORMALIZATION_BATCH_SIZE=5
FINANCE_JOB_STALE_SECONDS=300
FINANCE_NORMALIZATION_STALE_SECONDS=600
ICEBERG_WRITE_MAX_RETRIES=10
ICEBERG_WRITE_INITIAL_BACKOFF_SECONDS=1
ICEBERG_WRITE_MAX_BACKOFF_SECONDS=30
ICEBERG_WRITE_LOCK_TIMEOUT_SECONDS=300

AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://openfinance:openfinance@postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-a-secret-key
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=OpenFinance
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Optional registry override when Docker Hub is unreachable
PDF_PARSER_BASE_IMAGE=docker.1ms.run/nvidia/cuda:12.9.1-cudnn-runtime-ubuntu22.04
# Optional Ubuntu apt mirror override when the default archive is unreachable
UBUNTU_MIRROR=https://archive.ubuntu.com/ubuntu
