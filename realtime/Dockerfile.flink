ARG FLINK_BASE_IMAGE=docker.1ms.run/library/flink:1.20.3-scala_2.12-java17
FROM ${FLINK_BASE_IMAGE}
USER root
RUN wget -q -O /opt/flink/lib/flink-sql-connector-kafka.jar https://repo.maven.apache.org/maven2/org/apache/flink/flink-sql-connector-kafka/3.3.0-1.20/flink-sql-connector-kafka-3.3.0-1.20.jar \
    && test -s /opt/flink/lib/flink-sql-connector-kafka.jar
USER flink
